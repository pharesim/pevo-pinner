# PEvO Pinner Configuration
# Copy to .env and adjust values

# PostgreSQL connection string for HAF (required)
HAF_DATABASE_URL=postgresql://hafsql_public:hafsql_public@hafsql-sql.mahdiyari.info:5432/haf_block_log

# Hive app tag used to discover PEvO content
APP_TAG=pevotest

# IPFS backend mode: "embedded" (local storage + gateway) or "pinata" (Pinata API)
IPFS_MODE=embedded

# Directory for persistent IPFS storage (embedded mode)
DATA_DIR=~/.pevo-pinner

# Required if IPFS_MODE=pinata
# PINATA_API_KEY=your_api_key
# PINATA_SECRET_KEY=your_secret_key

# Management UI port
PORT=8421

# IPFS gateway port (embedded mode only)
GATEWAY_PORT=8100

# IPFS gateway bind IP. Default 127.0.0.1 keeps the gateway loopback-only —
# operators who want the boxo gateway reachable from outside the host must
# explicitly set this to 0.0.0.0 (or a specific NIC IP). A public gateway
# with DeserializedResponses=true is an open IPFS gateway: open abuse vector.
# GATEWAY_BIND=127.0.0.1

# How often to re-query HAF for new papers (Go duration format)
REFRESH_INTERVAL=1h

# Maximum in-flight autopin operations per discovery batch.
AUTOPIN_CONCURRENCY=4

# Maximum CIDs pinned from any single Hive author per discovery batch.
# Excess CIDs are shed with a per-author summary log line. Defends against
# a single hostile accredited author wedging the autopin queue.
AUTOPIN_AUTHOR_CAP=20

# Embedded-IPFS-node knobs (IPFS_MODE=embedded only). Defaults are sane for
# operators behind NAT — libp2p picks listen addresses, DHT bootstraps via
# its hardcoded seed peers, bitswap fetches per pin time out at 60s.

# Comma-separated libp2p listen multiaddrs. Empty = libp2p picks.
# LIBP2P_LISTEN=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/udp/4001/quic-v1

# PEvO main libp2p multiaddr (bootstrap peer). Empty = DHT-only bootstrap.
# PEVO_MAIN_LIBP2P_ADDR=/dns4/main.example.invalid/tcp/4001/p2p/12D3KooW...

# PEvO main HTTP gateway URL — first entry in the CAR-fetch fallback chain
# that runs when bitswap times out. CAR import block-level hash-verifies
# every byte; the gateway is not trusted with content authority.
# PEVO_MAIN_GATEWAY_URL=https://gateway.example.invalid

# Operator-supplied extra CAR-fetch gateway URLs (comma-separated). Inserted
# into the chain after PEvO main and before the public defaults.
# FALLBACK_GATEWAYS=https://my-gateway.invalid,https://another.invalid

# Per-Pin bitswap timeout. Go duration format.
# BITSWAP_TIMEOUT=60s

# Cap on bytes accepted from any single CAR-fetch response. Defends against
# a hostile gateway streaming hash-valid-but-unrelated blocks to fill disk.
# Default 1 GiB.
# MAX_PIN_BYTES=1073741824

# Community pinner mesh knobs. The mesh auto-discovers other pinners on the
# same APP_TAG via libp2p pubsub heartbeats. Discovered peers are dialed as
# bitswap providers and their gateway URLs are inserted into the CAR-fetch
# fallback chain.

# Disable the mesh entirely. Default: true (mesh enabled). Set to false to
# opt out — the bitswap + DHT + static fallback chain still works.
# MESH_ENABLED=true

# Public HTTP gateway URL advertised in mesh heartbeats so other pinners can
# add us to their fallback chains. Leave empty if the pinner's gateway port
# isn't reachable from the public internet.
# MESH_PUBLIC_GATEWAY_URL=https://my-pinner.example.invalid

# Heartbeat cadence and known-peers eviction TTL. Cadence default 30s,
# TTL default 5m — TTL >> cadence ensures a single dropped heartbeat
# does not evict a healthy peer.
# MESH_HEARTBEAT_INTERVAL=30s
# MESH_CACHE_TTL=5m

# Subscribe-only switch: pinner consumes mesh heartbeats but does not
# publish its own. Set to "true"/"1"/"yes" to enable.
# MESH_ADVERTISE_DISABLED=false

# Relax the SSRF guard on mesh-advertised gateway URLs so loopback / RFC1918
# hosts are accepted. Off by default; only operators running a private mesh
# on a trusted network should set this. Without it, a malicious mesh
# subscriber publishing GatewayURL=http://169.254.169.254/ or
# http://localhost:5432/ would let every pinner pivot into operator intranet.
# MESH_ALLOW_PRIVATE=false
